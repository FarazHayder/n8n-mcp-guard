# Copy this file to one of the locations below and fill in your values.
#
#   1. Beside the package, as .env          (git clone setup)
#   2. %APPDATA%\n8n-mcp-guard\.env        (Windows, one config for every repo)
#   3. ~/.config/n8n-mcp-guard/.env        (macOS / Linux, same idea)
#   4. Anywhere, then point N8N_MCP_ENV_FILE at it
#
# Variables already set in the real environment always win, so an MCP client
# that passes an `env` block overrides whatever is in this file.

# n8n instance root URL, or an explicit /api/v1 URL.
N8N_BASE_URL=https://your-instance.example.com

# Create in n8n under Settings -> n8n API. Never commit the real value.
N8N_API_KEY=

# Registers the read-only workflow inspection tool. Defaults to true.
ENABLE_N8N_WORKFLOW_TOOLS=true

# Setting a write token is what enables the mutating tools. Leave it empty
# for a strictly read-only server: with no token they are never registered.
# Use a long random value.
MCP_WRITE_AUTH_TOKEN=

# Write tools are on by default once a token is set. Set this to false to
# force them off even when a token is configured.
ENABLE_N8N_WORKFLOW_WRITE_TOOLS=true

# Registers the two topology-specific reference tools. Defaults to false.
# They only work against one exact Shopify/order-email workflow shape and
# fail closed everywhere else, so leave this off unless that is your shape.
ENABLE_EXAMPLE_TOOLS=false
